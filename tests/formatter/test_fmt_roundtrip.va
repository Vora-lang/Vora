// =========================================================================
// Formatter round-trip test — all features exercised through fmt → run
// Verifies the formatter produces valid, executable Vora code.
// =========================================================================

// Literals
let n = 42
let pi = 3.14
let s = "hello"
let t = true
let f = false
let nothing = null
print(n, pi, s, t, f, nothing)

// Float literals: the formatter must reproduce them losslessly, without
// exponent notation (the lexer has none), and without dropping the decimal
// point (which would silently turn a float into an int).
//
// Expectations below are deliberately computed at RUNTIME rather than written
// as a second literal: a literal expectation would be rewritten by the
// formatter exactly like the value under test, so symmetric corruption could
// pass unnoticed. A division is immune to that.
let numPrecise = 1234.5678
assert(numPrecise == 12345678.0 / 10000.0, "1234.5678 survives formatting exactly")

let numPi = 3.141592653589793
assert(numPi == 3141592653589793.0 / 1000000000000000.0, "pi keeps all 16 digits")

let numFp = 0.30000000000000004
assert(numFp == 0.1 + 0.2, "the 0.1+0.2 result survives exactly")

let numTiny = 0.0000001
assert(numTiny == 1.0 / 10000000.0, "1e-7 written in full survives")

// 9 significant digits. The ratio's mantissa (123456789) is below 2^53, so the
// division is exact and usable as an independent expectation.
let numNine = 1234.56789
assert(numNine == 123456789.0 / 100000.0, "9 significant digits survive")
// A large value with a long fraction. Its mantissa is not exactly representable,
// so compare against a range that only the right double falls in.
let numBig = 123456789.123456789
assert(numBig > 123456789.1234567 and numBig < 123456789.1234568, "a long fraction survives")

let numFar = 35184372088832.0
assert(numFar == 35184372088832.0 / 1.0, "a large float literal survives")
assert(type(numFar) == "float", "a large integral float stays a float")

// Integral floats must keep their type: without the trailing ".0" these would
// re-parse as integers.
let numIntLike = 42.0
assert(numIntLike == 42.0 / 1.0, "42.0 keeps its value")
assert(type(numIntLike) == "float", "42.0 stays a float")
assert(type(0.0) == "float", "0.0 stays a float")
assert(type(2.0) == "float", "2.0 stays a float")

// Negative zero. Its sign is NOT observable from a script: `/` raises on a zero
// divisor, and the constant pool deduplicates doubles by value (and -0.0 == 0.0),
// so 0.0 and -0.0 can share one constant. The formatter's "-0.0" output is
// therefore pinned in the C++ unit test instead (fmt_float_integral_values_stay_floats).
let numNegZero = -0.0
assert(numNegZero == 0.0, "-0.0 parses and compares equal to 0.0")

print(numPrecise, numPi, numFp, numTiny, numNine, numBig, numFar, numIntLike, numNegZero)

// Big integers: the formatter must re-emit oversized literals with their exact
// digits, so a formatted file still evaluates to the same values.
let bigLit = 123456789012345678901234567890
let bigNeg = -18446744073709551616
let bigHex = 0x10000000000000000
let bigSum = bigLit + bigNeg
let bigRem = bigLit % 1000000007
assert(bigLit == 123456789012345678901234567890, "big literal survives formatting")
assert(bigNeg == -18446744073709551616, "negative big literal survives formatting")
assert(bigHex == 18446744073709551616, "big hex literal survives formatting")
assert(bigSum == 123456788993898934827525016274, "big arithmetic survives formatting")
print(bigLit, bigNeg, bigHex, bigSum, bigRem)

// Arithmetic with precedence
let arith = 1 + 2 * 3 ** 2
assert(arith == 19, "1 + 2 * 9 should be 19")

// Parenthesized expressions
let paren = (1 + 2) * 3 ** 2
assert(paren == 27, "(1 + 2) * 9 should be 27")

// Compound assignments
let x = 10
x += 5
x -= 3
x *= 2
x /= 4
x %= 4
assert(x == 2, "compound assignment chain should give 2")

// Blocks
let z = 1
{
    let z = 2
    assert(z == 2, "inner z should be 2")
}
assert(z == 1, "outer z should be 1")

// If / else if / else
let score = 85
if (score >= 90) {
    print("A")
} else if (score >= 80) {
    print("B")
} else {
    print("C")
}

// While loop
let i = 0
while (i < 3) {
    i += 1
}
assert(i == 3, "i should be 3 after while loop")

// For-in loop
let arr = [1, 2, 3]
let forSum = 0
for item in arr {
    forSum += item
}
assert(forSum == 6, "forSum should be 6")

// Functions
func add(a, b) {
    return a + b
}
assert(add(3, 4) == 7, "add(3, 4) should be 7")

func noop() {}
assert(noop() == null, "noop() should return null")

// Closures
func makeAdder(n) {
    func adder(x) {
        return x + n
    }
    return adder
}
let add5 = makeAdder(5)
assert(add5(10) == 15, "add5(10) should be 15")

// Objects
class Point(x, y) {
    this.x = x
    this.y = y
}
let p = Point(3, 4)
assert(p.x == 3, "p.x should be 3")
assert(p.y == 4, "p.y should be 4")

// Property compound assignment
p.x += 1
assert(p.x == 4, "p.x += 1 should be 4")

// Index compound assignment
let nums = [10, 20]
nums[0] += 5
assert(nums[0] == 15, "nums[0] += 5 should be 15")

// Ternary
let max = 10 > 5 ? 10 : 5
assert(max == 10, "max should be 10")

let nested = true ? false ? 1 : 2 : 3
assert(nested == 2, "nested ternary should be 2")

// Try/catch
try {
    throw "test error"
} catch (e) {
    assert(e == "test error", "caught error should match")
}

// Logical operators
assert(true and 42 == 42, "true and 42 should be 42")
assert(false or "fallback" == "fallback", "false or fallback works")
assert(null || 42 == 42, "null || 42 should be 42")

// Inc/Dec
let incVal = 5
let preInc = ++incVal
assert(incVal == 6 and preInc == 6, "++incVal: both should be 6")
let postInc = incVal++
assert(incVal == 7 and postInc == 6, "incVal++: incVal=7, postInc=6")

// Property inc/dec
let ct = Point(0, 0)
ct.x++
assert(ct.x == 1, "ct.x++ should give 1")
++ct.y
assert(ct.y == 1, "++ct.y should give 1")

// String escapes + interpolation must survive formatting unchanged:
// escaped dollar, escaped backslash followed by interpolation, plain
// interpolation, and folded concatenation.
let escVar = 5
let escDollar = "\$"
let escOpen = "{"
let escClose = "}"
let escLit = escDollar + escOpen + "escVar" + escClose
assert("\${escVar}" == escLit, "escaped dollar survives fmt")
assert("\\${escVar}" == "\\5", "escaped backslash plus interpolation survives fmt")
assert("${escVar}" == "5", "plain interpolation survives fmt")
assert("\${escVar} = ${escVar}" == escLit + " = 5", "mixed escape and interpolation survives fmt")
assert(("[E]" + "${escVar}") == "[E]5", "folded interpolation survives fmt")

print("All formatter round-trip tests passed!")

// Labeled loops and labeled break/continue: the label has to survive formatting
// or these would change meaning (or stop compiling).
let lblContinue = ""
outer: for i in [1, 2, 3] {
    for j in [1, 2, 3] {
        if (j == 2) { continue outer }
        lblContinue = lblContinue + toString(i) + toString(j)
    }
}
assert(lblContinue == "112131", "labeled continue survives fmt")

let lblBreak = ""
outer2: for i in [1, 2, 3] {
    for j in [1, 2] {
        lblBreak = lblBreak + toString(i) + toString(j)
        if (i == 2) { break outer2 }
    }
}
assert(lblBreak == "111221", "labeled break survives fmt")

let lblWhile = ""
w: while (true) {
    lblWhile = lblWhile + "x"
    break w
}
assert(lblWhile == "x", "labeled while break survives fmt")

let lblDo = ""
d: do {
    lblDo = lblDo + "y"
    break d
} while (true)
assert(lblDo == "y", "labeled do-while break survives fmt")

let lblCFor = ""
c: for (let k = 0; k < 3; k = k + 1) {
    lblCFor = lblCFor + toString(k)
    if (k == 1) { continue c }
}
assert(lblCFor == "012", "labeled C-for continue survives fmt")

