// examples/39_module_import_relative.va — Relative module import demonstration
// Note: an explicit `as` alias is required — the path basename is not a valid
// identifier (starts with a digit), and Vora no longer derives bindings
// silently from such paths (syntax-review P0 #4).
import "./38_module_export" as module_export

print(module_export.hello("Vora"))
print("Version: " + module_export.VERSION)
print("Max retries: " + toString(module_export.MAX_RETRIES))
